DATAMIND_SERVICE_ENVIRONMENT=development
DATAMIND_SERVICE_HOST=0.0.0.0
DATAMIND_SERVICE_PORT=8700
DATAMIND_SERVICE_WORKERS=1

DATAMIND_CONSOLE_HOST=0.0.0.0
DATAMIND_CONSOLE_PORT=8701

DATAMIND_DATABASE_URL=postgresql+asyncpg://user:replace-with-database-password@host.docker.internal:5432/dbname

DATAMIND_TASK_QUEUE_BROKER_URL=redis://host.docker.internal:6379/0
DATAMIND_TASK_QUEUE_BATCH_QUEUE=prediction.batch
DATAMIND_TASK_QUEUE_SHADOW_QUEUE=prediction.shadow

DATAMIND_STORAGE_TYPE=minio
DATAMIND_STORAGE_MINIO_ENDPOINT=host.docker.internal:9000
DATAMIND_STORAGE_MINIO_BUCKET=datamind
DATAMIND_STORAGE_MINIO_ACCESS_KEY=replace-with-minio-access-key
DATAMIND_STORAGE_MINIO_SECRET_KEY=replace-with-minio-secret-key
DATAMIND_STORAGE_MINIO_SECURE=false

DATAMIND_AUTH_ENABLED=true
DATAMIND_AUTH_SECRET_KEY=replace-with-a-long-random-secret

DATAMIND_LOG_FORMAT=json
DATAMIND_LOG_ENABLE_CONSOLE=true
DATAMIND_LOG_CONSOLE_LEVEL=INFO
DATAMIND_LOG_ENABLE_FILE=false
