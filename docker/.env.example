# 运行环境
DATAMIND_ENVIRONMENT=development

# 默认时区
DATAMIND_TIMEZONE=Asia/Shanghai

# 预测服务
DATAMIND_SERVICE_HOST=0.0.0.0
DATAMIND_SERVICE_PORT=8700
DATAMIND_SERVICE_WORKERS=1

# 管理控制台
DATAMIND_CONSOLE_HOST=0.0.0.0
DATAMIND_CONSOLE_PORT=8701

# PostgreSQL
DATAMIND_DATABASE_URL=postgresql+asyncpg://user:password@postgres:5432/dbname

# Redis 任务队列
DATAMIND_TASK_QUEUE_BROKER_URL=redis://default:password@redis:6379/0
DATAMIND_TASK_QUEUE_BATCH_QUEUE=prediction.batch
DATAMIND_TASK_QUEUE_SHADOW_QUEUE=prediction.shadow

# MinIO 文件存储
DATAMIND_STORAGE_TYPE=minio
DATAMIND_STORAGE_MINIO_ENDPOINT=minio:9000
DATAMIND_STORAGE_MINIO_BUCKET=minio-bucket-name
DATAMIND_STORAGE_MINIO_ACCESS_KEY=minio-access-key
DATAMIND_STORAGE_MINIO_SECRET_KEY=minio-secret-key
DATAMIND_STORAGE_MINIO_SECURE=false

# 身份认证
DATAMIND_AUTH_ENABLED=true
DATAMIND_AUTH_SECRET_KEY=auth-secret-key
DATAMIND_AUTH_ALGORITHM=HS256
DATAMIND_AUTH_ACCESS_TOKEN_EXPIRES_MINUTES=30
DATAMIND_AUTH_REFRESH_TOKEN_EXPIRES_DAYS=7
DATAMIND_AUTH_LOCAL_MAX_FAILED_LOGIN_ATTEMPTS=5
DATAMIND_AUTH_LOCAL_LOCK_MINUTES=30
DATAMIND_AUTH_LOCAL_UPGRADE_PASSWORD_HASH=true
DATAMIND_AUTH_LOCAL_BREAK_GLASS_ONLY=false
DATAMIND_AUTH_LOCAL_ALLOWED_NETWORKS=[]
DATAMIND_AUTH_LOCAL_BREAK_GLASS_ACCESS_TOKEN_EXPIRES_MINUTES=15

# 审计
DATAMIND_AUDIT_ENABLED=true
DATAMIND_AUDIT_FAILURE_MODE=open
DATAMIND_AUDIT_MAX_RETRIES=2
DATAMIND_AUDIT_RETRY_BASE_DELAY=0.05

# 日志
DATAMIND_LOG_LEVEL=INFO
DATAMIND_LOG_FORMAT=json
DATAMIND_LOG_ENABLE_CONSOLE=true
DATAMIND_LOG_CONSOLE_LEVEL=INFO
DATAMIND_LOG_ENABLE_FILE=false
