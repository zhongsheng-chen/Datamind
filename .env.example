# Datamind 环境变量示例
#
# 将本文件复制为 .env 后再修改。不要提交包含真实密码、访问密钥或
# JWT 签名密钥的 .env 文件。

# 服务配置
# 可选值：development / testing / staging / production
DATAMIND_SERVICE_ENVIRONMENT=development
DATAMIND_SERVICE_NAME=datamind
DATAMIND_SERVICE_VERSION=1.0.0
DATAMIND_SERVICE_HOST=0.0.0.0
DATAMIND_SERVICE_PORT=3000
DATAMIND_SERVICE_WORKERS=4
DATAMIND_SERVICE_TIMEOUT=30
DATAMIND_SERVICE_RECONCILE_INTERVAL=2.0
DATAMIND_SERVICE_HEARTBEAT_INTERVAL=30.0
DATAMIND_SERVICE_ENABLE_DOCS=true
DATAMIND_SERVICE_ENABLE_HEALTH_CHECK=true

# PostgreSQL 配置
DATAMIND_DATABASE_URL=postgresql+asyncpg://datamind:replace-with-database-password@localhost:5432/datamind
DATAMIND_DATABASE_POOL_SIZE=10
DATAMIND_DATABASE_MAX_OVERFLOW=20
DATAMIND_DATABASE_POOL_TIMEOUT=30
DATAMIND_DATABASE_POOL_RECYCLE=3600
DATAMIND_DATABASE_ECHO=false

# LOCAL 认证与 JWT 配置
# development 默认不限制登录来源。staging 和 production 环境必须
# 配置实际的服务器地址或内网网段，否则认证服务拒绝启动。
# secret_key 应使用密码管理系统生成并注入的高强度随机值。
# CLI 登录凭据由 datamind login 保存，不要在此配置访问令牌。
DATAMIND_AUTH_ENABLED=true
DATAMIND_AUTH_SECRET_KEY=replace-with-a-long-random-secret
DATAMIND_AUTH_ALGORITHM=HS256
DATAMIND_AUTH_ACCESS_TOKEN_EXPIRES_MINUTES=30
DATAMIND_AUTH_REFRESH_TOKEN_EXPIRES_DAYS=7
DATAMIND_AUTH_LOCAL_MAX_FAILED_LOGIN_ATTEMPTS=5
DATAMIND_AUTH_LOCAL_LOCK_MINUTES=30
DATAMIND_AUTH_LOCAL_UPGRADE_PASSWORD_HASH=true
DATAMIND_AUTH_LOCAL_BREAK_GLASS_ONLY=false
DATAMIND_AUTH_LOCAL_ALLOWED_NETWORKS=[]
DATAMIND_AUTH_LOCAL_BREAK_GLASS_ACCESS_TOKEN_EXPIRES_MINUTES=15

# 审计配置
DATAMIND_AUDIT_ENABLED=true
DATAMIND_AUDIT_FAILURE_MODE=open
DATAMIND_AUDIT_MAX_RETRIES=2
DATAMIND_AUDIT_RETRY_BASE_DELAY=0.05

# 存储通用配置
# 可选值：local / minio
DATAMIND_STORAGE_TYPE=local
DATAMIND_STORAGE_MAX_FILE_SIZE=209715200
DATAMIND_STORAGE_MODEL_DIR=models

# 本地存储配置
DATAMIND_STORAGE_LOCAL_BASE_DIR=./data

# MinIO 配置；仅在 DATAMIND_STORAGE_TYPE=minio 时需要填写访问密钥。
DATAMIND_STORAGE_MINIO_ENDPOINT=localhost:9000
DATAMIND_STORAGE_MINIO_BUCKET=datamind
DATAMIND_STORAGE_MINIO_ACCESS_KEY=
DATAMIND_STORAGE_MINIO_SECRET_KEY=
DATAMIND_STORAGE_MINIO_SECURE=false
# DATAMIND_STORAGE_MINIO_REGION=cn-north-1
DATAMIND_STORAGE_MINIO_BASE_PREFIX=datamind

# 日志配置
DATAMIND_LOG_LEVEL=INFO
DATAMIND_LOG_FORMAT=json
DATAMIND_LOG_ENCODING=utf-8
DATAMIND_LOG_DIR=logs
DATAMIND_LOG_FILENAME=datamind.log
# DATAMIND_LOG_DATE_FORMAT=%Y-%m-%d %H:%M:%S
DATAMIND_LOG_TIMEZONE=Asia/Shanghai
DATAMIND_LOG_ROTATION=time
DATAMIND_LOG_ROTATION_WHEN=MIDNIGHT
DATAMIND_LOG_ROTATION_INTERVAL=1
DATAMIND_LOG_MAX_BYTES=104857600
DATAMIND_LOG_BACKUP_COUNT=30
DATAMIND_LOG_RETENTION_DAYS=90
DATAMIND_LOG_ENABLE_CONSOLE=false
DATAMIND_LOG_ENABLE_FILE=true
DATAMIND_LOG_ENABLE_ASYNC=false
DATAMIND_LOG_SAMPLE_RATE=1.0
DATAMIND_LOG_MASK_SENSITIVE=true
DATAMIND_LOG_MASK_CHAR=*
DATAMIND_LOG_UNMASKED_PREFIX=2
DATAMIND_LOG_UNMASKED_SUFFIX=2

# 评分配置
DATAMIND_CLASSIFICATION_THRESHOLD=0.5
DATAMIND_SCORECARD_BASE_SCORE=600.0
DATAMIND_SCORECARD_BASE_ODDS=50.0
DATAMIND_SCORECARD_PDO=20.0
DATAMIND_SCORECARD_MIN_SCORE=0.0
DATAMIND_SCORECARD_MAX_SCORE=1000.0
