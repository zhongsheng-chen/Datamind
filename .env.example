# Datamind 环境变量配置
#
# 复制本文件为 .env 后使用。
# 默认配置均保持注释状态，只需取消需要覆盖的配置项注释。
# 不要将真实密码、密钥或访问凭据提交到版本库。


# -----------------------------------------------------------------------------
# ServiceConfig
# -----------------------------------------------------------------------------

## 服务运行环境。
#  必填。
#  可选值：development、testing、staging、production。
DATAMIND_SERVICE_ENVIRONMENT=development

## 服务名称。
#  默认值：datamind
# DATAMIND_SERVICE_NAME=datamind

## 服务版本。
#  默认值：1.0.0
# DATAMIND_SERVICE_VERSION=1.0.0

## HTTP 监听地址。
#  默认值：0.0.0.0
# DATAMIND_SERVICE_HOST=0.0.0.0

## HTTP 监听端口。
#  默认值：8700
# DATAMIND_SERVICE_PORT=8700

## BentoML Worker 数量。
#  默认值：4
# DATAMIND_SERVICE_WORKERS=4

## 请求超时时间，单位为秒。
#  默认值：30
# DATAMIND_SERVICE_TIMEOUT=30

## 是否启用 API 文档。
#  默认值：true
# DATAMIND_SERVICE_ENABLE_DOCS=true

## 是否启用健康检查。
#  默认值：true
# DATAMIND_SERVICE_ENABLE_HEALTH_CHECK=true


# -----------------------------------------------------------------------------
# ConsoleConfig
# -----------------------------------------------------------------------------

## 管理控制台监听地址。
#  默认值：127.0.0.1
# DATAMIND_CONSOLE_HOST=127.0.0.1

## 管理控制台监听端口。
#  默认值：8701
# DATAMIND_CONSOLE_PORT=8701


# -----------------------------------------------------------------------------
# InitializationConfig
# -----------------------------------------------------------------------------

## 首个管理员用户名。
#  默认值：admin
# DATAMIND_INIT_ADMIN_USERNAME=admin

## 首个管理员密码。
#  默认值：admin
#  生产环境应在初始化前覆盖该值；初始化完成后应从环境中移除。
# DATAMIND_INIT_ADMIN_PASSWORD=admin


# -----------------------------------------------------------------------------
# RuntimeConfig
# -----------------------------------------------------------------------------

## 运行状态协调间隔，单位为秒。
#  默认值：2.0
# DATAMIND_RUNTIME_RECONCILE_INTERVAL=2.0

## Worker 心跳间隔，单位为秒。
#  默认值：30.0
# DATAMIND_RUNTIME_HEARTBEAT_INTERVAL=30.0

## 是否执行影子预测。
#  默认值：true
# DATAMIND_RUNTIME_SHADOW_ENABLED=true

## 单个 Worker 的影子任务队列容量。
#  默认值：1024
# DATAMIND_RUNTIME_SHADOW_QUEUE_SIZE=1024

## 单个 Worker 的影子执行并发数。
#  默认值：2
# DATAMIND_RUNTIME_SHADOW_WORKER_COUNT=2

## 单次影子预测超时时间，单位为秒。
#  默认值：5.0
# DATAMIND_RUNTIME_SHADOW_TIMEOUT=5.0


# -----------------------------------------------------------------------------
# DatabaseConfig
# -----------------------------------------------------------------------------

## SQLAlchemy 异步 PostgreSQL 连接地址。
#  必填。
DATAMIND_DATABASE_URL=postgresql+asyncpg://datamind:replace-with-database-password@localhost:5432/datamind

## 连接池常驻连接数。
#  默认值：10
# DATAMIND_DATABASE_POOL_SIZE=10

## 连接池允许创建的额外连接数。
#  默认值：20
# DATAMIND_DATABASE_MAX_OVERFLOW=20

## 获取数据库连接的最长等待时间，单位为秒。
#  默认值：30
# DATAMIND_DATABASE_POOL_TIMEOUT=30

## 连接回收周期，单位为秒。
#  默认值：3600
# DATAMIND_DATABASE_POOL_RECYCLE=3600

## 是否输出 SQL 调试日志。
#  默认值：false
# DATAMIND_DATABASE_ECHO=false


# -----------------------------------------------------------------------------
# StorageConfig
# -----------------------------------------------------------------------------

## 存储后端类型。
#  默认值：local
#  可选值：local、minio。
# DATAMIND_STORAGE_TYPE=local

## 单个文件大小上限，单位为字节。
#  默认值：209715200
# DATAMIND_STORAGE_MAX_FILE_SIZE=209715200

## 模型对象的相对目录。
#  默认值：models
# DATAMIND_STORAGE_MODEL_DIR=models


# -----------------------------------------------------------------------------
# LocalStorageConfig
# -----------------------------------------------------------------------------

## 本地存储根目录。
#  默认值：./data
# DATAMIND_STORAGE_LOCAL_BASE_DIR=./data


# -----------------------------------------------------------------------------
# MinIOStorageConfig
# -----------------------------------------------------------------------------

## MinIO 服务地址。
#  默认值：localhost:9000
# DATAMIND_STORAGE_MINIO_ENDPOINT=localhost:9000

## MinIO 存储桶。
#  默认值：datamind
# DATAMIND_STORAGE_MINIO_BUCKET=datamind

## MinIO 访问密钥。
#  使用 MinIO 时必填。
# DATAMIND_STORAGE_MINIO_ACCESS_KEY=replace-with-minio-access-key

## MinIO 秘密密钥。
#  使用 MinIO 时必填。
# DATAMIND_STORAGE_MINIO_SECRET_KEY=replace-with-minio-secret-key

## 是否使用 TLS 连接 MinIO。
#  默认值：false
# DATAMIND_STORAGE_MINIO_SECURE=false

## MinIO 区域。
#  默认值：None
#  示例值：cn-north-1
# DATAMIND_STORAGE_MINIO_REGION=cn-north-1

## MinIO 对象键前缀。
#  默认值：datamind
# DATAMIND_STORAGE_MINIO_BASE_PREFIX=datamind


# -----------------------------------------------------------------------------
# AuthConfig
# -----------------------------------------------------------------------------

## 是否启用认证。
#  默认值：false
# DATAMIND_AUTH_ENABLED=false

## JWT 签名密钥。
#  默认值：空字符串
#  启用认证时必填，应通过密钥管理系统注入。
# DATAMIND_AUTH_SECRET_KEY=replace-with-a-long-random-secret

## JWT 签名算法。
#  默认值：HS256
# DATAMIND_AUTH_ALGORITHM=HS256

## 访问令牌有效期，单位为分钟。
#  默认值：30
# DATAMIND_AUTH_ACCESS_TOKEN_EXPIRES_MINUTES=30

## 刷新令牌有效期，单位为天。
#  默认值：7
# DATAMIND_AUTH_REFRESH_TOKEN_EXPIRES_DAYS=7


# -----------------------------------------------------------------------------
# LocalAuthConfig
# -----------------------------------------------------------------------------

## 连续登录失败次数上限。
#  默认值：5
# DATAMIND_AUTH_LOCAL_MAX_FAILED_LOGIN_ATTEMPTS=5

## 账户锁定时间，单位为分钟。
#  默认值：30
# DATAMIND_AUTH_LOCAL_LOCK_MINUTES=30

## 登录成功后是否升级旧密码哈希。
#  默认值：true
# DATAMIND_AUTH_LOCAL_UPGRADE_PASSWORD_HASH=true

## 是否仅允许 LOCAL 认证用于紧急访问。
#  默认值：false
# DATAMIND_AUTH_LOCAL_BREAK_GLASS_ONLY=false

## LOCAL 认证允许的地址或网段。
#  默认值：[]
# DATAMIND_AUTH_LOCAL_ALLOWED_NETWORKS=[]

## 紧急访问令牌有效期，单位为分钟。
#  默认值：15
# DATAMIND_AUTH_LOCAL_BREAK_GLASS_ACCESS_TOKEN_EXPIRES_MINUTES=15


# -----------------------------------------------------------------------------
# AuditConfig
# -----------------------------------------------------------------------------

## 是否记录审计事件。
#  默认值：true
# DATAMIND_AUDIT_ENABLED=true

## 审计写入失败策略。
#  默认值：open
#  可选值：open、closed。
# DATAMIND_AUDIT_FAILURE_MODE=open

## 审计写入最大重试次数。
#  默认值：2
# DATAMIND_AUDIT_MAX_RETRIES=2

## 审计写入初始重试延迟，单位为秒。
#  默认值：0.05
# DATAMIND_AUDIT_RETRY_BASE_DELAY=0.05


# -----------------------------------------------------------------------------
# LoggingConfig
# -----------------------------------------------------------------------------

## 日志级别。
#  默认值：INFO
#  可选值：DEBUG、INFO、WARNING、ERROR、CRITICAL。
# DATAMIND_LOG_LEVEL=INFO

## 日志输出格式。
#  默认值：json
#  可选值：json、text。
# DATAMIND_LOG_FORMAT=json

## 日志文件编码。
#  默认值：utf-8
# DATAMIND_LOG_ENCODING=utf-8

## 日志目录。
#  默认值：logs
# DATAMIND_LOG_DIR=logs

## 日志文件名。
#  默认值：datamind.log
# DATAMIND_LOG_FILENAME=datamind.log

## 日志时间格式。
#  默认值：None（ISO 8601）
#  示例值：%Y-%m-%d %H:%M:%S
# DATAMIND_LOG_DATE_FORMAT=%Y-%m-%d %H:%M:%S

## 日志时区。
#  默认值：Asia/Shanghai
# DATAMIND_LOG_TIMEZONE=Asia/Shanghai

## 日志轮转策略。
#  默认值：time
#  可选值：time、size。
# DATAMIND_LOG_ROTATION=time

## 按时间轮转时的触发时机。
#  默认值：MIDNIGHT
# DATAMIND_LOG_ROTATION_WHEN=MIDNIGHT

## 日志轮转间隔。
#  默认值：1
# DATAMIND_LOG_ROTATION_INTERVAL=1

## 按大小轮转时的单文件大小上限，单位为字节。
#  默认值：104857600
# DATAMIND_LOG_MAX_BYTES=104857600

## 日志备份文件数量。
#  默认值：30
# DATAMIND_LOG_BACKUP_COUNT=30

## 日志保留天数。
#  默认值：90
# DATAMIND_LOG_RETENTION_DAYS=90

## 是否输出到控制台。
#  默认值：false
# DATAMIND_LOG_ENABLE_CONSOLE=false

## 是否输出到日志文件。
#  默认值：true
# DATAMIND_LOG_ENABLE_FILE=true

## 是否使用异步日志处理。
#  默认值：false
# DATAMIND_LOG_ENABLE_ASYNC=false

## 日志采样率。
#  默认值：1.0
#  取值范围：0.0 至 1.0。
# DATAMIND_LOG_SAMPLE_RATE=1.0

## 是否遮罩敏感值。
#  默认值：true
# DATAMIND_LOG_MASK_SENSITIVE=true

## 敏感值遮罩字符。
#  默认值：*
# DATAMIND_LOG_MASK_CHAR=*

## 敏感值头部保留字符数。
#  默认值：2
# DATAMIND_LOG_UNMASKED_PREFIX=2

## 敏感值尾部保留字符数。
#  默认值：2
# DATAMIND_LOG_UNMASKED_SUFFIX=2


# -----------------------------------------------------------------------------
# ClassificationConfig
# -----------------------------------------------------------------------------

## 二分类判定阈值。
#  默认值：0.5
#  取值范围：0.0 至 1.0。
# DATAMIND_CLASSIFICATION_THRESHOLD=0.5


# -----------------------------------------------------------------------------
# ScoringConfig
# -----------------------------------------------------------------------------

## 评分决策阈值，评分大于等于该值时通过。
#  默认值：600.0
# DATAMIND_SCORING_THRESHOLD=600.0
