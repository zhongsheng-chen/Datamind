  "api_models": {
    "ControlRequest": {
      "endpoints": "`POST /admin/reload`",
      "example": {
        "deployment_id": "<deployment_id>"
      }
    },
    "DeploymentRequest": {
      "endpoints": "`POST /admin/status`",
      "example": {
        "deployment_id": "<deployment_id>"
      }
    },
    "PredictRequest": {
      "endpoints": "`POST /predict`",
      "example": {
        "model_name": "<model_name>",
        "subject_key": "borrower-001",
        "subject_type": "borrower",
        "features": {
          "<feature_name>": "<value>"
        }
      }
    },
    "PredictionInstance": {
      "endpoints": "作为 `BatchPredictRequest.instances` 的元素，不直接提交到独立路径",
      "example": {
        "subject_key": "borrower-001",
        "subject_type": "borrower",
        "features": {
          "<feature_name>": "<value>"
        }
      }
    },
    "BatchPredictRequest": {
      "endpoints": "`POST /predict/batch`",
      "example": {
        "model_name": "<model_name>",
        "instances": [
          {
            "subject_key": "borrower-001",
            "subject_type": "borrower",
            "features": {
              "<feature_name>": "<value>"
            }
          },
          {
            "subject_key": "borrower-002",
            "subject_type": "borrower",
            "features": {
              "<feature_name>": "<value>"
            }
          }
        ]
      }
    },
    "BatchReferenceRequest": {
      "endpoints": "`POST /predict/batch/status`、`POST /predict/batch/cancel`、`POST /predict/batch/retry`",
      "example": {
        "batch_id": "<batch_id>"
      }
    }
  },
